{
  "display_information": {
    "name": "Codex Agent Bridge",
    "description": "Connect selected local Codex agents to Slack",
    "background_color": "#1a1a2e"
  },
  "features": {
    "bot_user": {
      "display_name": "Codex Agent",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/sab-stop",
        "description": "Interrupt the active session's running turn",
        "should_escape": false
      },
      {
        "command": "/sab-status",
        "description": "Show this session or list sessions from the control channel",
        "usage_hint": "[claude | codex]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "commands",
        "chat:write",
        "channels:read",
        "channels:history",
        "groups:read",
        "groups:history"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "message.channels",
        "message.groups"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
